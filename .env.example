# Offline-first mode. Set false only after configuring the providers below.
DEMO_MODE=true

# OpenAI-compatible LLM (DeepSeek example; never commit a real key)
LLM_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.1

# Public web research
TAVILY_API_KEY=

# MySQL structured data
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=research
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=company_data

# RAGFlow private knowledge
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# API and filesystem
CORS_ORIGINS=http://localhost:5173
EXTERNAL_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=10
MAX_EXTRACTED_CHARS=200000
MAX_AGENT_STEPS=100
LOG_LEVEL=INFO

# Optional Docker host port overrides
BACKEND_PORT=8000
FRONTEND_PORT=5173
MYSQL_EXPOSE_PORT=3306
